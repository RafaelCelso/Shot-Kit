<Window x:Class="ShotKit.Views.PinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShotKit - Imagem fixada"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="#FF2F80ED" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Cursor="SizeAll">
    <Grid>
        <!-- Borda de 1 px (fundo da janela) indica que a imagem está fixada. -->
        <Image x:Name="PinnedImage" Margin="1" Stretch="Fill"
               RenderOptions.BitmapScalingMode="HighQuality" />
        <Border x:Name="ZoomBadge" Background="#CC1F2328" CornerRadius="3" Padding="6,2"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6"
                IsHitTestVisible="False" Visibility="Collapsed">
            <TextBlock x:Name="ZoomText" Foreground="White" FontSize="12" />
        </Border>
    </Grid>
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem x:Name="MenuCopy" Header="Copiar" InputGestureText="Ctrl+C" />
            <MenuItem x:Name="MenuSave" Header="Salvar como..." InputGestureText="Ctrl+S" />
            <MenuItem x:Name="MenuOcr" Header="Extrair texto (OCR)" />
            <Separator />
            <MenuItem x:Name="MenuZoomReset" Header="Tamanho original" InputGestureText="Ctrl+0" />
            <MenuItem Header="Opacidade">
                <MenuItem x:Name="Opacity100" Header="100%" Tag="1.0" />
                <MenuItem x:Name="Opacity80" Header="80%" Tag="0.8" />
                <MenuItem x:Name="Opacity60" Header="60%" Tag="0.6" />
                <MenuItem x:Name="Opacity40" Header="40%" Tag="0.4" />
            </MenuItem>
            <Separator />
            <MenuItem x:Name="MenuClose" Header="Fechar" InputGestureText="Esc" />
        </ContextMenu>
    </Window.ContextMenu>
</Window>
